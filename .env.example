# SAHAYAK AI (सहायक) - Environment Configuration Example
# Copy this file to .env.local for local development.
# IMPORTANT: Keep real credentials out of version control.

# 1. Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# 2. Google Gemini API Configuration (Server-Only)
# Found in: Google AI Studio -> Get API Key (https://aistudio.google.com/apikey)
# NEVER expose this key to the browser bundle.
GEMINI_API_KEY=your_gemini_api_key

# 3. Gemini Live Model Identifier
# The model used for bidirectional audio Live sessions.
# Confirmed live working model: gemini-3.8-live
GEMINI_LIVE_MODEL=gemini-3.8-live

# 4. Optional Application URL (for OAuth redirect fallback)
# Defaults to request origin or http://localhost:3000 in local development
NEXT_PUBLIC_APP_URL=http://localhost:3000



GEMINI_OAUTH_SECRET=your_gemini_oauth_secret